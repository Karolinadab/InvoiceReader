{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Uvicorn (main:app)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Upload Service (module, debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.services.upload_service",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": []
    }
  ]
}
